# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
!.env.example

# Data & artifacts (large, regenerable)
data/raw/
data/processed/
data/vector_db/
data/eval/review_batch_*.html
models/
logs/

# Academic source PDFs (large, re-downloadable via URLs in docs/sources/README.md)
docs/sources/*.pdf

# OS noise
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code per-user settings
.claude/settings.local.json

# Training pairs (regenerable from the DB; manifest is committed)
data/training/*.jsonl
data/training/*.jsonl.gz
data/training/card_tags_*.json

# Scryfall comparator result sets (~2 MB of oracle_ids; regenerable in ~5 min via
# scripts/scryfall_comparator.py fetch). The committed manifest records what was fetched.
data/eval/scryfall_results_*.json

# Presentation build outputs (regenerable: see docs/thesis/presentation/presentation-notes.md).
# Screenshots contain card art; keep them out of the public repo.
docs/thesis/presentation/*.pptx
docs/thesis/presentation/assets/
docs/thesis/presentation/node_modules/
docs/thesis/presentation/package-lock.json
