# Copy this file to .env and fill in real values.
# .env is gitignored; .env.example is committed as the schema reference.

# Postgres credentials. docker-compose.yml interpolates these at container
# start; src/config.py reads DATABASE_URL via pydantic-settings. Keep all
# four in sync (DATABASE_URL embeds the same user/password/db).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mtg_search
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/mtg_search

# Anthropic API key. OPTIONAL — used for the Scryfall comparator (LLM-crafted
# expert queries, task #20) and optional LLM-based evaluation tooling
# (task #25). NOT used for HyDE — HyDE runs a local MLX model, see below.
# Leave blank until the comparator implementation lands.
ANTHROPIC_API_KEY=

# ---- HyDE query rewriter (local MLX inference on Apple Silicon) ----
# The HyDE stage calls a local OpenAI-compatible LLM server. On macOS the
# default is `mlx_lm.server`; on other platforms substitute any compatible
# backend (vLLM, llama.cpp server, TGI) and point HYDE_SERVER_URL at it.
# HYDE_MODEL=mlx-community/Meta-Llama-3.1-8B-Instruct-4bit
# HYDE_SERVER_URL=http://localhost:8080/v1
# HYDE_MAX_TOKENS=512
# HYDE_TEMPERATURE=0.0

# ---- Embeddings (Nomic Embed v1.5 by default) ----
# Overrides for the embedding model. Defaults in src/config.py are the
# values committed to in CLAUDE.md; override here only for experiments.
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# EMBEDDING_DIM=768
# MAX_LENGTH=512
# EMBED_BATCH_SIZE=32
